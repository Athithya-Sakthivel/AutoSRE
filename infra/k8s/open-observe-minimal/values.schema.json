{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "replicaCount",
    "image",
    "secrets",
    "config",
    "persistence",
    "service",
    "resources",
    "podSecurityContext",
    "containerSecurityContext",
    "probes",
    "lifecycle",
    "terminationGracePeriodSeconds"
  ],
  "properties": {
    "replicaCount": { "type": "integer", "const": 1 },
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "image": {
      "type": "object",
      "required": ["registry", "repository", "digest", "pullPolicy"],
      "properties": {
        "registry":   { "type": "string", "minLength": 1 },
        "repository": { "type": "string", "minLength": 1 },
        "tag":        { "type": "string" },
        "digest":     { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "pullPolicy": { "type": "string", "enum": ["IfNotPresent", "Always", "Never"] }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": { "name": { "type": "string", "minLength": 1 } }
      }
    },
    "serviceAccount": {
      "type": "object",
      "required": ["create", "automountServiceAccountToken"],
      "properties": {
        "create": { "type": "boolean" },
        "name":   { "type": "string" },
        "annotations": { "type": "object" },
        "automountServiceAccountToken": { "type": "boolean", "const": false }
      }
    },
    "secrets": {
      "type": "object",
      "required": ["auth"],
      "additionalProperties": false,
      "properties": {
        "auth":    { "type": "string", "minLength": 1 },
        "storage": { "type": "string", "minLength": 1 }
      }
    },
    "config": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "string" }
    },
    "persistence": {
      "type": "object",
      "required": ["enabled", "size", "accessMode", "storageClass"],
      "additionalProperties": false,
      "properties": {
        "enabled":      { "type": "boolean", "const": true },
        "size":         { "type": "string", "pattern": "^[1-9][0-9]*(Mi|Gi|Ti)$" },
        "accessMode":   { "type": "string", "const": "ReadWriteOnce" },
        "storageClass": { "type": "string", "minLength": 1 },
        "annotations":  { "type": "object" }
      }
    },
    "service": {
      "type": "object",
      "required": ["type", "port"],
      "properties": {
        "type": { "type": "string", "const": "ClusterIP" },
        "port": { "type": "integer", "const": 5080 },
        "annotations": { "type": "object" }
      }
    },
    "resources": {
      "type": "object",
      "required": ["requests", "limits"]
    },
    "podSecurityContext":       { "type": "object" },
    "containerSecurityContext": { "type": "object" },
    "probes":       { "type": "object" },
    "lifecycle":    { "type": "object" },
    "terminationGracePeriodSeconds": {
      "type": "integer",
      "minimum": 30,
      "maximum": 3600
    },
    "networkPolicy": {
      "type": "object",
      "required": ["enabled"],
      "properties": {
        "enabled":       { "type": "boolean" },
        "additionalFrom": { "type": "array" }
      }
    },
    "podAnnotations":    { "type": "object" },
    "podLabels":         { "type": "object" },
    "nodeSelector":      { "type": "object" },
    "tolerations":       { "type": "array" },
    "affinity":          { "type": "object" },
    "extraEnv":          { "type": "array" },
    "extraEnvFrom":      { "type": "array" },
    "extraVolumes":      { "type": "array" },
    "extraVolumeMounts": { "type": "array" }
  }
}
