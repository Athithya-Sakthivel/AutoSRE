{
  "name": "AutoSRE",
  "image": "ghcr.io/athithya-sakthivel/autosre-devcontainer:2026.10.04@sha256:cc44ab58647afcefd07236a7cc79a2b3c376e81b0560ff1bdea9d40a01de91b1"
//   "build": { "dockerfile": "Dockerfile","context": "." },   First time image build
// "image":   pinned image
  ,
  "workspaceFolder": "/workspace",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=cached",
  "remoteUser": "root",
  "postCreateCommand": "bash /usr/local/share/devcontainer-bootstrap.sh --post-create && pre-commit install --install-hooks --overwrite",
  "forwardPorts": [
    3000, 3001, 8000, 8001, 8080, 50051,
    8005, 7000, 7001, 7002, 7003, 6379,
    9153, 9090, 30080, 443, 80, 18080, 18082, 18090
  ],
  "runArgs": [
    "--privileged",
    "--network=host",
    "--cap-add=SYS_PTRACE",
    "--security-opt=seccomp=unconfined",
    "-v", "/var/run/docker.sock:/var/run/docker.sock",
    "--shm-size=10g"
  ],
  "remoteEnv": {
  "DISPLAY": "",
  "WAYLAND_DISPLAY": ""
  },
  "containerEnv": {
    "DOCKER_GID": "999",
    "DOCKER_PROXY_HOST": "",
    "DOCKER_PROXY_PORT": ""
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode-remote.remote-containers"
      ],
      "settings": {
        "files.autoSave": "afterDelay",
        "files.autoSaveDelay": 1000,
        "terminal.integrated.scrollback": 3500,
        "workbench.colorTheme": "Default Dark Modern",
        "workbench.preferredDarkColorTheme": "Default Dark Modern"
      }
    }
  }
}
